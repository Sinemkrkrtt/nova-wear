# ÖRNEK DOSYA — buraya GERÇEK anahtar YAZILMAZ.
# Değerler functions/.env dosyasına girilir; o dosya .gitignore'dadır.
# Anahtarlar iyzico ve Cloudinary panellerinden alınır.

# Copy this file to functions/.env and fill in real values.
# functions/.env is git-ignored and is loaded automatically by Firebase.
#
# PRODUCTION: replace the sandbox values below with your LIVE iyzico keys
# from https://merchant.iyzipay.com and redeploy.

IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_URI=https://sandbox-api.iyzipay.com

# App Check zorunluluğu. Kurulum + test tamamlanınca "true" yap.
APPCHECK_ENFORCE=false

# Cloudinary imzalı yükleme (Settings > API Keys)
CLOUDINARY_CLOUD_NAME=dh3xo6sjg
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lavia

# --- MARKA / ADRES ---
BRAND_NAME=Nova Wear
SITE_URL=
ORDER_PREFIX=NW

# --- SİPARİŞ BİLDİRİM E-POSTASI (Gmail) ---
# MAIL_APP_PASSWORD, Google Hesabı > Güvenlik > Uygulama şifreleri'nden alınır.
# ASLA koda yazılmaz; yalnızca functions/.env dosyasında durur.
MAIL_USER=
MAIL_APP_PASSWORD=
NOTIFY_EMAIL=
