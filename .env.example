# ---------------------------------------------------------------------------
# NOVA WEAR — ORTAM DEĞİŞKENLERİ
#
# Bu dosyayı ".env" adıyla kopyala ve değerleri doldur:
#     cp .env.example .env
#
# ÖNEMLİ: ".env" dosyası .gitignore'da — asla git'e gönderilmez, göndermeyin.
# CRA kuralı gereği tüm değişkenler REACT_APP_ ile başlamak zorunda.
# .env dosyasını değiştirdikten sonra "npm start"ı yeniden başlatman gerekir.
#
# HİÇBİRİNİ DOLDURMAZSAN NE OLUR?
# Site "DEMO MOD"da açılır: örnek ürünlerle tasarımı görebilirsin ama
# gerçek veri, sepet kaydı, ödeme ve admin paneli çalışmaz.
# Tasarım aşaması için bu yeterli.
# ---------------------------------------------------------------------------

# --- FIREBASE (zorunlu) ---
# Firebase Console > Proje Ayarları > "Uygulamalarınız" > Web uygulaması
# bölümündeki firebaseConfig nesnesinden birebir kopyalanır.
# Not: Bu değerler gizli anahtar DEĞİLDİR, tarayıcıya zaten gönderilirler.
# Asıl güvenlik firestore.rules ve App Check tarafından sağlanır.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# --- APP CHECK (opsiyonel, bot koruması) ---
# Firebase Console > App Check > reCAPTCHA v3 site anahtarı.
# Boş bırakılırsa App Check devre dışı kalır, site yine çalışır.
REACT_APP_APPCHECK_RECAPTCHA_KEY=

# --- CLOUDINARY (ürün görselleri) ---
# Görseller tarayıcıdan doğrudan Cloudinary'ye yüklenir (imzasız/unsigned).
# CLOUD_NAME: Cloudinary panelinde sağ üstte yazan hesap adı.
# UPLOAD_PRESET: Settings > Upload > Upload presets > "Unsigned" bir ön ayar
#   oluşturup adını buraya yazın. Ön ayarda klasörü ve izin verilen dosya
#   türlerini sınırlamayı unutmayın (bkz. src/utils/storage.js).
REACT_APP_CLOUDINARY_CLOUD_NAME=
REACT_APP_CLOUDINARY_UPLOAD_PRESET=

# --- CLOUD FUNCTIONS (opsiyonel) ---
# Ödeme ve görsel yükleme fonksiyonlarının yayınlandığı temel adres.
# Boş bırakılırsa proje kimliğinden otomatik türetilir.
# Örn: https://us-central1-nova-wear.cloudfunctions.net
REACT_APP_FUNCTIONS_BASE_URL=

# ---------------------------------------------------------------------------
# SUNUCU TARAFI (bu dosyaya DEĞİL, functions/.env dosyasına yazılır)
# iyzico ve Cloudinary gizli anahtarları için functions/.env.example'a bak.
# Onlar gerçek sırlardır ve tarayıcıya asla gönderilmemelidir.
# ---------------------------------------------------------------------------
